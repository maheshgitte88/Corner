{
  "name": "counter-retail",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "node --test tests/*.test.js",
    "demo": "npm run build && node scripts/demo.js",
    "format": "prettier --write \"client/src/**/*.{jsx,js,css}\" \"server/src/**/*.js\" \"shared/*.js\" \"tests/*.js\" \"scripts/*.js\"",
    "test:unit": "node --test tests/billing.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test:saas": "node --test tests/saas.test.js",
    "migrate:legacy": "node scripts/migrate-legacy.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
