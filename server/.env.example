MONGODB_URI=mongodb://127.0.0.1:27017/counter?replicaSet=rs0
PORT=4100
CLIENT_URL=http://localhost:5174
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
NODE_ENV=development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
# Optional public CDN base URL. Bucket objects must be readable through this URL.
S3_PUBLIC_BASE_URL=

# SaaS platform administrator (separate from any client login)
PLATFORM_ADMIN_EMAIL=platform@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
# Only seed retail demo products in a disposable database
SEED_DEMO=false

# Image storage: cloudinary (default) or s3. Restart the backend after editing.
# Compression is opt-in; true converts new uploads to resized WebP.
IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGE_COMPRESSION_ENABLED=false
IMAGE_COMPRESSION_QUALITY=80
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1600
